# NOVAMART Frontend Configuration (Vite + React)

# Base URL for NOVAMART Backend REST API
# Development default: http://localhost:5000/api/v1
# Production example: https://api.novamart.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Stripe Client Publishable Key
# Production key: pk_live_... / Development key: pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_51ABCxyz
