# NOVAMART Backend Configuration

# Server Runtime
NODE_ENV=development
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Example for local MongoDB: mongodb://127.0.0.1:27017/novamart
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/novamart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/novamart

# JWT Secrets
JWT_SECRET=novamart_super_secret_jwt_access_key_change_in_production_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=novamart_super_secret_refresh_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=30d

# Password Salt Rounds
BCRYPT_SALT_ROUNDS=10

# Stripe Payment Gateway (Phase 4)
STRIPE_SECRET_KEY=sk_test_placeholder_key_51ABCxyz
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_51ABCxyz
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_xyz

# Cloudinary Cloud Media Storage (Phase 4)
CLOUDINARY_CLOUD_NAME=novamart-media
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=placeholder_cloudinary_api_secret_xyz
